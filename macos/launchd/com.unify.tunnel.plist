<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.unify.tunnel</string>

	<key>ProgramArguments</key>
	<array>
		<string>%RATHOLE_BIN%</string>
		<string>%RATHOLE_CONFIG%</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<!-- Run rathole whenever client.toml exists; restart on crash/sleep/wake;
	     never crash-loop while unregistered (config absent). launchd owns the
	     tunnel lifecycle via the config file's presence. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
		<key>PathState</key>
		<dict>
			<key>%RATHOLE_CONFIG%</key>
			<true/>
		</dict>
	</dict>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>%LOG_DIR%/rathole.log</string>

	<key>StandardErrorPath</key>
	<string>%LOG_DIR%/rathole.log</string>
</dict>
</plist>
