#!/bin/bash
# postinstall - Post-installation script for .pkg installer
#
# Flow:
#   1. Synchronous: write .env config (no node required)
#   2. Deferred (background): install Node.js if needed
#      → run full setup.sh (deps, patchright, launchd, etc.) → start services
#
# Mirrors: ubuntu/installer/DEBIAN/postinst

set -e

APP_DIR="/opt/unify-desktop-assistant"
SETUP_SCRIPT="$APP_DIR/tools/setup.sh"
LOG_DIR="$APP_DIR/logs"
SELF_HOST_AGENT_PORT=13000
COMPOSE_SELF_HOST_ORCHESTRA_URL="http://127.0.0.1:8000/v0"
COMPOSE_SELF_HOST_COMMS_URL="http://127.0.0.1:8001"

echo "[postinstall] Configuring Unify Desktop Assistant..."

# Determine the real (GUI console) user. The installer runs as root, so $USER is
# root. Resolve the logged-in user via scutil — the canonical method — because
# `stat -f '%Su' /dev/console` is unreliable (on some macOS versions/states
# /dev/console is owned by root even with a user logged in, which silently
# skipped the API-key prompt and the user-context setup). Fall back to the
# legacy methods only if scutil yields nothing usable.
TARGET_USER="$(scutil <<< 'show State:/Users/ConsoleUser' 2>/dev/null | awk '/Name :/ { print $3 }')"
if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "loginwindow" ] || [ "$TARGET_USER" = "root" ]; then
    TARGET_USER="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
fi
if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
    TARGET_USER="${SUDO_USER:-$USER}"
fi
TARGET_HOME="$(eval echo "~$TARGET_USER")"
TARGET_UID="$(id -u "$TARGET_USER" 2>/dev/null || echo "")"

# Load baked URLs from environment.conf (cloud SaaS defaults)
ENV_CONF="$APP_DIR/environment.conf"
if [ -f "$ENV_CONF" ]; then
    . "$ENV_CONF"
fi
ORCHESTRA_URL="${ORCHESTRA_URL:-https://api.unify.ai/v0}"
UNITY_COMMS_URL="${UNITY_COMMS_URL:-https://service.a.run.app}"

COMPOSE_SELF_HOST=0
AGENT_PORT=3000
SELF_HOST_FLAG=0
if [ -f "$TARGET_HOME/.unity/docker-compose.yml" ]; then
    COMPOSE_SELF_HOST=1
    AGENT_PORT=$SELF_HOST_AGENT_PORT
    SELF_HOST_FLAG=1
    ORCHESTRA_URL="$COMPOSE_SELF_HOST_ORCHESTRA_URL"
    UNITY_COMMS_URL="$COMPOSE_SELF_HOST_COMMS_URL"
    echo "[postinstall] Unity compose self-host detected at $TARGET_HOME/.unity — agent port ${AGENT_PORT}"
fi

chmod +x "$SETUP_SCRIPT"

# Phase 1: Write .env config immediately (no node/npm needed)
mkdir -p "$APP_DIR/agent-service"

# Preserve existing tunnel/device values on upgrade
ENV_FILE="$APP_DIR/agent-service/.env"
EXISTING_UNIFY_KEY=""
EXISTING_TUNNEL_ID=""
EXISTING_TUNNEL_URL=""
EXISTING_TUNNEL_TOKEN=""
EXISTING_DEVICE_ID=""
EXISTING_SFTP_TUNNEL_ID=""
EXISTING_SFTP_TUNNEL_HOST=""
EXISTING_SFTP_TUNNEL_PORT=""
if [ -f "$ENV_FILE" ]; then
    EXISTING_UNIFY_KEY=$(grep -E '^UNIFY_KEY=' "$ENV_FILE" 2>/dev/null | sed 's/^UNIFY_KEY=//' || true)
    EXISTING_TUNNEL_ID=$(grep -E '^TUNNEL_ID=' "$ENV_FILE" 2>/dev/null | sed 's/^TUNNEL_ID=//' || true)
    EXISTING_TUNNEL_URL=$(grep -E '^TUNNEL_URL=' "$ENV_FILE" 2>/dev/null | sed 's/^TUNNEL_URL=//' || true)
    EXISTING_TUNNEL_TOKEN=$(grep -E '^TUNNEL_TOKEN=' "$ENV_FILE" 2>/dev/null | sed 's/^TUNNEL_TOKEN=//' || true)
    EXISTING_DEVICE_ID=$(grep -E '^DEVICE_ID=' "$ENV_FILE" 2>/dev/null | sed 's/^DEVICE_ID=//' || true)
    # Preserve the SFTP tunnel id/coords too — dropping them makes the next
    # registration mint a fresh tunnel and orphan the old one on every upgrade.
    EXISTING_SFTP_TUNNEL_ID=$(grep -E '^SFTP_TUNNEL_ID=' "$ENV_FILE" 2>/dev/null | sed 's/^SFTP_TUNNEL_ID=//' || true)
    EXISTING_SFTP_TUNNEL_HOST=$(grep -E '^SFTP_TUNNEL_HOST=' "$ENV_FILE" 2>/dev/null | sed 's/^SFTP_TUNNEL_HOST=//' || true)
    EXISTING_SFTP_TUNNEL_PORT=$(grep -E '^SFTP_TUNNEL_PORT=' "$ENV_FILE" 2>/dev/null | sed 's/^SFTP_TUNNEL_PORT=//' || true)
fi

# Use existing key if present (upgrade), otherwise leave blank (first-run dialog will prompt)
UNIFY_KEY="${EXISTING_UNIFY_KEY:-}"

# Fresh install with no key: prompt the logged-in user via a native dialog.
# Runs in the user's GUI session (launchctl asuser). Falls back to keyless if
# headless (e.g. `sudo installer` over SSH), cancelled, or left blank — in which
# case the menu-bar app prompts for the key on first launch.
if [ -z "$UNIFY_KEY" ] && [ -n "$TARGET_UID" ] && [ "$TARGET_USER" != "root" ]; then
    echo "[postinstall] Prompting for Unify API Key..."
    if [ "$COMPOSE_SELF_HOST" = "1" ]; then
        PROMPT_BODY="Enter your Coordinator API key (Console: Connect your desktop). Unity self-host uses agent port ${AGENT_PORT}; Console stays on 3000."
    else
        PROMPT_BODY="Enter your Unify API Key to finish setup.

Leave blank or click Skip to configure later from the menu-bar app."
    fi
    PROMPT_SCRIPT="try
set r to display dialog \"${PROMPT_BODY}\" default answer \"\" with hidden answer with title \"Unify Desktop Assistant\" with icon note buttons {\"Skip\", \"Continue\"} default button \"Continue\"
if button returned of r is \"Continue\" then
return text returned of r
end if
end try"
    UNIFY_KEY="$(launchctl asuser "$TARGET_UID" sudo -u "$TARGET_USER" /usr/bin/osascript -e "$PROMPT_SCRIPT" 2>/dev/null || true)"
    UNIFY_KEY="$(printf '%s' "$UNIFY_KEY" | tr -d '\r\n')"
    if [ -n "$UNIFY_KEY" ]; then
        echo "[postinstall] API key provided — will complete full setup (services + Screen Sharing)."
    else
        echo "[postinstall] No key entered — installing prerequisites only."
    fi
fi

cat > "$ENV_FILE" <<ENVFILE
# Agent Service Environment Configuration
# Generated by postinstall: $(date)

PORT=$AGENT_PORT
UNIFY_KEY=$UNIFY_KEY
ORCHESTRA_URL=$ORCHESTRA_URL
UNITY_COMMS_URL=$UNITY_COMMS_URL
SELF_HOST=$SELF_HOST_FLAG
PLAYWRIGHT_BROWSERS_PATH=$APP_DIR/browsers

# Tunnel & Device (managed by setup/registration)
TUNNEL_ID=$EXISTING_TUNNEL_ID
TUNNEL_URL=$EXISTING_TUNNEL_URL
TUNNEL_TOKEN=$EXISTING_TUNNEL_TOKEN
DEVICE_ID=$EXISTING_DEVICE_ID

# SFTP tunnel (preserved across upgrades so we reuse it instead of orphaning it)
SFTP_TUNNEL_ID=$EXISTING_SFTP_TUNNEL_ID
SFTP_TUNNEL_HOST=$EXISTING_SFTP_TUNNEL_HOST
SFTP_TUNNEL_PORT=$EXISTING_SFTP_TUNNEL_PORT
ENVFILE
echo "[postinstall] Agent Service .env configured."

# Phase 2: Deferred — full setup after installer UI completes
mkdir -p "$LOG_DIR"
(
    echo "[$(date)] Starting deferred setup..."

    # Node.js (and all other deps) are installed by setup.sh as the target user.
    # setup.sh loads Homebrew's shellenv itself, so it works even though this
    # non-interactive context doesn't source the user's ~/.zshrc.

    # Enable Screen Sharing while we still have root privileges.
    #
    # IMPORTANT: kickstart must run inside the logged-in user's GUI (Aqua) session,
    # not the bare installd/root context. From installd there is no GUI session, so
    # kickstart writes the Remote-Management config to disk but the ARD agent that
    # binds port 5900 never activates — the listener stays down even though the
    # config reads "enabled". `launchctl asuser "$TARGET_UID"` runs kickstart as
    # root but within the user's bootstrap namespace, so 5900 actually binds (and
    # persists across logins).
    KICKSTART="/System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart"
    if [ -f "$KICKSTART" ] && [ -n "$UNIFY_KEY" ] && [ -n "$TARGET_UID" ]; then
        echo "[$(date)] Enabling Screen Sharing (in $TARGET_USER's session)..."
        # Run as root within the user's GUI session so port 5900 binds. setup.sh
        # --enable-screen-sharing turns on Apple Screen Sharing (ARD account auth;
        # the viewer signs in with the macOS username + password).
        launchctl asuser "$TARGET_UID" "$SETUP_SCRIPT" --enable-screen-sharing 2>&1 || true
    fi

    # Hand ownership of the install dir to the target user BEFORE running setup,
    # so the user-context install (Homebrew/npm/bun/pip) can write into it.
    chown -R "$TARGET_USER" "$APP_DIR" 2>/dev/null || true

    # Full setup runs as the target user — Homebrew/npm/bun refuse to run as root.
    echo "[$(date)] Running setup.sh as $TARGET_USER..."
    if [ -n "$UNIFY_KEY" ]; then
        if [ "$COMPOSE_SELF_HOST" = "1" ]; then
            su - "$TARGET_USER" -c "'$SETUP_SCRIPT' --force --no-start \
                --unify-key '$UNIFY_KEY' \
                --self-host --link-coordinator" || {
                echo "[$(date)] WARNING: setup.sh encountered errors" >&2
            }
        else
            su - "$TARGET_USER" -c "'$SETUP_SCRIPT' --force --no-start \
                --unify-key '$UNIFY_KEY' \
                --orchestra-url '$ORCHESTRA_URL' \
                --unity-comms-url '$UNITY_COMMS_URL'" || {
                echo "[$(date)] WARNING: setup.sh encountered errors" >&2
            }
        fi
    else
        echo "[$(date)] No UNIFY_KEY set (first install). Installing prerequisites only."
        echo "[$(date)] The tray app will prompt for the API key on first launch."
        su - "$TARGET_USER" -c "'$SETUP_SCRIPT' --prereqs-only --force" 2>&1 || {
            echo "[$(date)] WARNING: prereqs-only setup encountered errors" >&2
        }
    fi

    # Re-assert ownership (root-owned files may have appeared during setup)
    chown -R "$TARGET_USER" "$APP_DIR" 2>/dev/null || true

    # Start services as the target user (only if key is configured)
    if [ -n "$UNIFY_KEY" ]; then
        echo "[$(date)] Starting services as $TARGET_USER..."
        su - "$TARGET_USER" -c "'$SETUP_SCRIPT' --start" || {
            echo "[$(date)] WARNING: Service start failed" >&2
        }
    fi

    # Tray app: setup.sh (run as the user above) installs and bootstraps the
    # launchd agent. Nudge it to start now; otherwise it loads at next login.
    if [ -n "$TARGET_UID" ]; then
        echo "[$(date)] Starting tray app via launchd..."
        su - "$TARGET_USER" -c "launchctl kickstart -k gui/$TARGET_UID/com.unify.tray" 2>/dev/null || true
    fi

    echo "[$(date)] Post-install complete."
) &>"$LOG_DIR/postinstall-deferred.log" &
disown

echo ""
echo "Installation complete!"
echo "Dependencies and services are being set up in the background."
echo "Progress: tail -f $LOG_DIR/postinstall-deferred.log"
echo ""

exit 0
