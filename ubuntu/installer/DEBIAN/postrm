#!/bin/bash
# postrm - Post-removal script
# Cleans up systemd units, firewall rules, autostart entries, and leftover files.

set -e

APP_DIR="/opt/unify-desktop-assistant"

case "$1" in
    remove)
        # Remove systemd user services for all users that may have them
        for user_home in /home/*; do
            user_systemd_dir="$user_home/.config/systemd/user"
            if [ -d "$user_systemd_dir" ]; then
                for svc in unify-vnc unify-websockify unify-agent unify-tray; do
                    rm -f "$user_systemd_dir/${svc}.service" 2>/dev/null || true
                done
            fi

            # Remove autostart entry
            rm -f "$user_home/.config/autostart/unify-desktop-assistant.desktop" 2>/dev/null || true
        done

        # Remove UFW rules if ufw is available
        if command -v ufw >/dev/null 2>&1; then
            ufw delete allow 6080/tcp 2>/dev/null || true
            ufw delete allow 3000/tcp 2>/dev/null || true
        fi

        echo "Unify Desktop Assistant removed."
        ;;

    purge)
        # Remove everything including config/data
        rm -rf "$APP_DIR" 2>/dev/null || true

        # Remove systemd user services for all users
        for user_home in /home/*; do
            user_systemd_dir="$user_home/.config/systemd/user"
            if [ -d "$user_systemd_dir" ]; then
                for svc in unify-vnc unify-websockify unify-agent unify-tray; do
                    rm -f "$user_systemd_dir/${svc}.service" 2>/dev/null || true
                done
            fi
            rm -f "$user_home/.config/autostart/unify-desktop-assistant.desktop" 2>/dev/null || true
        done

        # Remove UFW rules
        if command -v ufw >/dev/null 2>&1; then
            ufw delete allow 6080/tcp 2>/dev/null || true
            ufw delete allow 3000/tcp 2>/dev/null || true
        fi

        # Purge debconf data
        if command -v db_purge >/dev/null 2>&1; then
            . /usr/share/debconf/confmodule
            db_purge || true
        fi

        echo "Unify Desktop Assistant purged."
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
