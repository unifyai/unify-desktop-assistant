#!/bin/bash
# config - debconf configuration script
# Called BEFORE postinst to collect user input (API key only).
# URLs are determined at build time (main vs staging), not user-configurable.
# This script can be re-run (dpkg-reconfigure) to change the API key.

set -e

# Source debconf library
. /usr/share/debconf/confmodule

# Check for existing configuration (upgrade scenario)
ENV_FILE="/opt/unify-desktop-assistant/agent-service/.env"
if [ -f "$ENV_FILE" ]; then
    # Pre-fill from existing .env (upgrade path)
    existing_key=$(grep -oP '^UNIFY_KEY=\K.*' "$ENV_FILE" 2>/dev/null || true)
    if [ -n "$existing_key" ]; then
        db_set unify-desktop-assistant/unify-key "$existing_key"
    fi
fi

# Ask for API key (required)
db_input high unify-desktop-assistant/unify-key || true
db_go || true

# Validate API key was provided
db_get unify-desktop-assistant/unify-key
while [ -z "$RET" ]; do
    db_input critical unify-desktop-assistant/unify-key || true
    db_go || true
    db_get unify-desktop-assistant/unify-key
done
