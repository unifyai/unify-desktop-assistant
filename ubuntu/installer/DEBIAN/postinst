#!/bin/bash
# postinst - Post-installation script
#
# Flow:
#   1. Synchronous: write .env config (no node required)
#   2. Deferred (background): wait for dpkg lock release → install Node.js v22
#      → run full setup.sh (deps, patchright, systemd, etc.) → start services

set -e

APP_DIR="/opt/unify-desktop-assistant"
SETUP_SCRIPT="$APP_DIR/tools/setup.sh"
LOG_DIR="$APP_DIR/logs"

case "$1" in
    configure)
        # Source debconf
        . /usr/share/debconf/confmodule

        # Get API key from debconf
        db_get unify-desktop-assistant/unify-key
        UNIFY_KEY="$RET"

        # URLs are baked at build time (main vs staging) in environment.conf
        ENV_CONF="$APP_DIR/environment.conf"
        if [ -f "$ENV_CONF" ]; then
            . "$ENV_CONF"
        fi
        ORCHESTRA_URL="${ORCHESTRA_URL:-https://api.unify.ai/v0}"
        UNITY_COMMS_URL="${UNITY_COMMS_URL:-https://unity-comms-app-000000000000.us-central1.run.app}"

        chmod +x "$SETUP_SCRIPT"

        # Phase 1: Write .env config immediately (no node/npm needed)
        mkdir -p "$APP_DIR/agent-service"

        # Preserve existing tunnel/device values on upgrade
        ENV_FILE="$APP_DIR/agent-service/.env"
        EXISTING_TUNNEL_ID=""
        EXISTING_TUNNEL_URL=""
        EXISTING_TUNNEL_TOKEN=""
        EXISTING_DEVICE_ID=""
        if [ -f "$ENV_FILE" ]; then
            EXISTING_TUNNEL_ID=$(grep -oP '^TUNNEL_ID=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_TUNNEL_URL=$(grep -oP '^TUNNEL_URL=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_TUNNEL_TOKEN=$(grep -oP '^TUNNEL_TOKEN=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_DEVICE_ID=$(grep -oP '^DEVICE_ID=\K.*' "$ENV_FILE" 2>/dev/null || true)
        fi

        cat > "$ENV_FILE" <<ENVFILE
# Agent Service Environment Configuration
# Generated by postinst: $(date)

PORT=3000
UNIFY_KEY=$UNIFY_KEY
ORCHESTRA_URL=$ORCHESTRA_URL
UNITY_COMMS_URL=$UNITY_COMMS_URL
PLAYWRIGHT_BROWSERS_PATH=$APP_DIR/browsers

# Tunnel & Device (managed by setup/registration)
TUNNEL_ID=$EXISTING_TUNNEL_ID
TUNNEL_URL=$EXISTING_TUNNEL_URL
TUNNEL_TOKEN=$EXISTING_TUNNEL_TOKEN
DEVICE_ID=$EXISTING_DEVICE_ID
ENVFILE
        echo "Agent Service .env configured."

        # Stop debconf to avoid holding the pipe
        db_stop || true

        # Phase 2: Deferred — full setup after dpkg releases its lock
        # Node.js is not in Depends (Ubuntu repos only provide old versions),
        # so we install v22 via nodesource here, then run setup.sh for everything else.
        mkdir -p "$LOG_DIR"
        (
            # Wait for dpkg to release its lock
            while fuser /var/lib/dpkg/lock-frontend &>/dev/null 2>&1; do
                sleep 2
            done

            echo "[$(date)] dpkg lock released, running deferred setup..."

            # The deferred phase runs after dpkg released its lock, so apt is
            # usable here. Clear the dpkg maintainer-script vars so setup.sh does
            # not auto-enable SKIP_APT (it inherits them from this postinst) and
            # can self-heal the Node install if the step below falls short.
            unset DPKG_MAINTSCRIPT_PACKAGE DPKG_MAINTSCRIPT_NAME DPKG_MAINTSCRIPT_ARCH

            # Install Node.js v22 if needed (nodesource). npx must be present —
            # the distro `nodejs` package provides `node` but not `npm`/`npx`.
            NODE_MAJOR=$(node --version 2>/dev/null | sed 's/v\([0-9]*\).*/\1/')
            if [ -z "$NODE_MAJOR" ] || [ "$NODE_MAJOR" -lt 22 ] || ! command -v npx >/dev/null 2>&1; then
                echo "[$(date)] Installing Node.js v22 via nodesource..."
                # `curl ... | bash -` silently swallows curl failures (empty
                # stdin → bash exits 0), leaving distro Node without npm/npx.
                # Download first, abort on a bad fetch, then run.
                NS_SCRIPT="/tmp/nodesource_setup_22.sh"
                if curl -fsSL https://deb.nodesource.com/setup_22.x -o "$NS_SCRIPT"; then
                    bash "$NS_SCRIPT"
                    apt-get install -y nodejs
                    rm -f "$NS_SCRIPT"
                else
                    echo "[$(date)] WARNING: Failed to fetch NodeSource setup script." >&2
                fi

                # Fall back to distro npm if npx is still missing.
                if ! command -v npx >/dev/null 2>&1; then
                    echo "[$(date)] npx missing after Node install; installing distro npm as fallback..." >&2
                    apt-get install -y npm || true
                fi

                if command -v npx >/dev/null 2>&1; then
                    echo "[$(date)] Node.js installed: $(node --version), npx: $(npx --version 2>/dev/null || echo '?')"
                else
                    echo "[$(date)] WARNING: npx still unavailable; setup.sh will retry the Node install." >&2
                fi
            else
                echo "[$(date)] Node.js $(node --version) already >= v22 (npx present)"
            fi

            # Full setup: install deps, configure systemd/autostart/firewall, don't start yet
            echo "[$(date)] Running setup.sh..."
            "$SETUP_SCRIPT" \
                --force \
                --no-start \
                --unify-key "$UNIFY_KEY" \
                --orchestra-url "$ORCHESTRA_URL" \
                --unity-comms-url "$UNITY_COMMS_URL" || {
                echo "[$(date)] WARNING: setup.sh encountered errors" >&2
            }

            # Ensure install dir is owned by target user (belt-and-suspenders for chown in setup.sh)
            TARGET_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
            if [ "$TARGET_USER" != "root" ]; then
                chown -R "$TARGET_USER":"$(id -gn "$TARGET_USER")" "$APP_DIR" 2>/dev/null || true
            fi

            # Detect DISPLAY from display.env (written by start-display.sh) or fall back to :0
            DISPLAY_ENV="$APP_DIR/logs/display.env"
            if [ -f "$DISPLAY_ENV" ]; then
                . "$DISPLAY_ENV"
            fi
            DISPLAY="${DISPLAY:-:0}"
            export DISPLAY

            # Start services as the target user (so they can be stopped without root)
            echo "[$(date)] Starting services as $TARGET_USER (DISPLAY=$DISPLAY)..."
            su - "$TARGET_USER" -c "DISPLAY=$DISPLAY $SETUP_SCRIPT --start" || {
                echo "[$(date)] WARNING: Service start failed" >&2
            }

            # Launch tray app if a display is available
            if [ -f "$APP_DIR/gui/unify-assistant.py" ]; then
                echo "[$(date)] Launching tray app..."
                su - "$TARGET_USER" -c "DISPLAY=$DISPLAY nohup python3 $APP_DIR/gui/unify-assistant.py &>/dev/null &" || true
            fi

            echo "[$(date)] Post-install complete."
        ) &>"$LOG_DIR/postinst-deferred.log" &
        disown

        echo ""
        echo "=================================================="
        echo "  Unify Desktop Assistant is installed"
        echo "=================================================="
        echo ""
        echo "Dependencies and services are being set up in the background"
        echo "(this can take a few minutes on first install)."
        echo ""
        echo "The Unify icon will appear in your system tray and turn green"
        echo "once services are running. You can change your API key anytime"
        echo "from the tray icon's Settings."
        echo ""
        echo "Progress: tail -f $LOG_DIR/postinst-deferred.log"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
