#!/bin/bash
# postinst - Post-installation script
#
# Flow:
#   1. Synchronous: write .env config (no node required)
#   2. Deferred (background): wait for dpkg lock release → install Node.js v22
#      → run full setup.sh (deps, patchright, systemd, etc.) → start services

set -e

APP_DIR="/opt/unify-desktop-assistant"
SETUP_SCRIPT="$APP_DIR/tools/setup.sh"
LOG_DIR="$APP_DIR/logs"

case "$1" in
    configure)
        # Source debconf
        . /usr/share/debconf/confmodule

        # Get API key from debconf
        db_get unify-desktop-assistant/unify-key
        UNIFY_KEY="$RET"

        # URLs are baked at build time (main vs staging) in environment.conf
        ENV_CONF="$APP_DIR/environment.conf"
        if [ -f "$ENV_CONF" ]; then
            . "$ENV_CONF"
        fi
        ORCHESTRA_URL="${ORCHESTRA_URL:-https://api.unify.ai/v0}"
        UNITY_COMMS_URL="${UNITY_COMMS_URL:-https://unity-comms-app-000000000000.us-central1.run.app}"

        chmod +x "$SETUP_SCRIPT"

        # Phase 1: Write .env config immediately (no node/npm needed)
        mkdir -p "$APP_DIR/agent-service"
        cat > "$APP_DIR/agent-service/.env" <<ENVFILE
# Agent Service Environment Configuration
# Generated by postinst: $(date)

PORT=3000
UNIFY_KEY=$UNIFY_KEY
ORCHESTRA_URL=$ORCHESTRA_URL
UNITY_COMMS_URL=$UNITY_COMMS_URL
ENVFILE
        echo "Agent Service .env configured."

        # Stop debconf to avoid holding the pipe
        db_stop || true

        # Phase 2: Deferred — full setup after dpkg releases its lock
        # Node.js is not in Depends (Ubuntu repos only provide old versions),
        # so we install v22 via nodesource here, then run setup.sh for everything else.
        mkdir -p "$LOG_DIR"
        (
            # Wait for dpkg to release its lock
            while fuser /var/lib/dpkg/lock-frontend &>/dev/null 2>&1; do
                sleep 2
            done

            echo "[$(date)] dpkg lock released, running deferred setup..."

            # Install Node.js v22 if needed (nodesource)
            NODE_MAJOR=$(node --version 2>/dev/null | sed 's/v\([0-9]*\).*/\1/')
            if [ -z "$NODE_MAJOR" ] || [ "$NODE_MAJOR" -lt 22 ]; then
                echo "[$(date)] Installing Node.js v22 via nodesource..."
                curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
                apt-get install -y nodejs
                echo "[$(date)] Node.js installed: $(node --version)"
            else
                echo "[$(date)] Node.js $(node --version) already >= v22"
            fi

            # Full setup: install deps, configure systemd/autostart/firewall, don't start yet
            echo "[$(date)] Running setup.sh..."
            "$SETUP_SCRIPT" \
                --force \
                --no-start \
                --unify-key "$UNIFY_KEY" \
                --orchestra-url "$ORCHESTRA_URL" \
                --unity-comms-url "$UNITY_COMMS_URL" || {
                echo "[$(date)] WARNING: setup.sh encountered errors" >&2
            }

            # Start services as the target user (so they can be stopped without root)
            TARGET_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
            echo "[$(date)] Starting services as $TARGET_USER..."
            su - "$TARGET_USER" -c "DISPLAY=:0 $SETUP_SCRIPT --start" || {
                echo "[$(date)] WARNING: Service start failed" >&2
            }

            # Launch tray app if a display is available
            if [ -f "$APP_DIR/gui/unify-assistant.py" ]; then
                echo "[$(date)] Launching tray app..."
                su - "$TARGET_USER" -c "DISPLAY=:0 nohup python3 $APP_DIR/gui/unify-assistant.py &>/dev/null &" || true
            fi

            echo "[$(date)] Post-install complete."
        ) &>"$LOG_DIR/postinst-deferred.log" &
        disown

        echo ""
        echo "Installation complete!"
        echo "Node.js, dependencies, and services are being set up in the background."
        echo "Progress: tail -f $LOG_DIR/postinst-deferred.log"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
