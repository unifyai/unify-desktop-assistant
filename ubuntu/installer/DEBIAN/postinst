#!/bin/bash
# postinst - Post-installation script
#
# Flow:
#   1. Synchronous: write .env config (no node required)
#   2. Deferred (background): wait for dpkg lock release → install Node.js v22
#      → run full setup.sh (deps, patchright, systemd, etc.) → start services

set -e

APP_DIR="/opt/unify-desktop-assistant"
SETUP_SCRIPT="$APP_DIR/tools/setup.sh"
LOG_DIR="$APP_DIR/logs"
SELF_HOST_AGENT_PORT=13000
COMPOSE_SELF_HOST_ORCHESTRA_URL="http://127.0.0.1:8000/v0"
COMPOSE_SELF_HOST_COMMS_URL="http://127.0.0.1:8001"

case "$1" in
    configure)
        TARGET_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
        TARGET_HOME="$(eval echo "~$TARGET_USER")"

        # URLs are baked at build time (main vs staging) in environment.conf.
        # Its presence means a stamped build - the stamped URL always wins
        # over a stray ~/.unity compose file below, otherwise a
        # staging/production install would silently register against
        # localhost. Local-stack auto-detect only applies to an unstamped
        # (dev) build.
        ENV_CONF="$APP_DIR/environment.conf"
        STAMPED=0
        if [ -f "$ENV_CONF" ]; then
            STAMPED=1
            . "$ENV_CONF"
        fi

        COMPOSE_SELF_HOST=0
        AGENT_PORT=3000
        SELF_HOST_FLAG=0
        if [ "$STAMPED" != "1" ] && [ -f "$TARGET_HOME/.unity/docker-compose.yml" ]; then
            COMPOSE_SELF_HOST=1
            AGENT_PORT=$SELF_HOST_AGENT_PORT
            SELF_HOST_FLAG=1
            echo "Unity compose self-host detected at $TARGET_HOME/.unity — agent port ${AGENT_PORT}"
        fi

        chmod +x "$SETUP_SCRIPT"

        # Phase 1: Write a minimal .env immediately (no node/npm needed).
        # The API key is intentionally left empty — the system tray will show a
        # first-run dialog on launch so the user can enter it after the stack is
        # running. On upgrade, the existing key and device/tunnel IDs are preserved.
        mkdir -p "$APP_DIR/agent-service"

        ENV_FILE="$APP_DIR/agent-service/.env"
        EXISTING_UNIFY_KEY=""
        EXISTING_TUNNEL_ID=""
        EXISTING_TUNNEL_URL=""
        EXISTING_TUNNEL_TOKEN=""
        EXISTING_DEVICE_ID=""
        EXISTING_SFTP_TUNNEL_ID=""
        EXISTING_SFTP_TUNNEL_HOST=""
        EXISTING_SFTP_TUNNEL_PORT=""
        if [ -f "$ENV_FILE" ]; then
            EXISTING_UNIFY_KEY=$(grep -oP '^UNIFY_KEY=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_TUNNEL_ID=$(grep -oP '^TUNNEL_ID=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_TUNNEL_URL=$(grep -oP '^TUNNEL_URL=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_TUNNEL_TOKEN=$(grep -oP '^TUNNEL_TOKEN=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_DEVICE_ID=$(grep -oP '^DEVICE_ID=\K.*' "$ENV_FILE" 2>/dev/null || true)
            # Preserve the SFTP tunnel id/coords too — dropping them makes the next
            # registration mint a fresh tunnel and orphan the old one on every upgrade.
            EXISTING_SFTP_TUNNEL_ID=$(grep -oP '^SFTP_TUNNEL_ID=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_SFTP_TUNNEL_HOST=$(grep -oP '^SFTP_TUNNEL_HOST=\K.*' "$ENV_FILE" 2>/dev/null || true)
            EXISTING_SFTP_TUNNEL_PORT=$(grep -oP '^SFTP_TUNNEL_PORT=\K.*' "$ENV_FILE" 2>/dev/null || true)
        fi

        if [ "$COMPOSE_SELF_HOST" = "1" ]; then
            ORCHESTRA_URL="$COMPOSE_SELF_HOST_ORCHESTRA_URL"
            UNITY_COMMS_URL="$COMPOSE_SELF_HOST_COMMS_URL"
        elif [ -z "${ORCHESTRA_URL:-}" ] || [ -z "${UNITY_COMMS_URL:-}" ]; then
            # Fail loudly rather than silently registering against production
            # when no backend URL resolved (a stamped build with a
            # missing/corrupt environment.conf).
            echo "ERROR: No backend URL configured (missing or empty $ENV_CONF)." >&2
            exit 1
        fi

        cat > "$ENV_FILE" <<ENVFILE
# Agent Service Environment Configuration
# Generated by postinst: $(date)

PORT=$AGENT_PORT
UNIFY_KEY=$EXISTING_UNIFY_KEY
ORCHESTRA_URL=$ORCHESTRA_URL
UNITY_COMMS_URL=$UNITY_COMMS_URL
SELF_HOST=$SELF_HOST_FLAG
PLAYWRIGHT_BROWSERS_PATH=$APP_DIR/browsers

# Tunnel & Device (managed by setup/registration)
TUNNEL_ID=$EXISTING_TUNNEL_ID
TUNNEL_URL=$EXISTING_TUNNEL_URL
TUNNEL_TOKEN=$EXISTING_TUNNEL_TOKEN
DEVICE_ID=$EXISTING_DEVICE_ID

# SFTP tunnel (preserved across upgrades so we reuse it instead of orphaning it)
SFTP_TUNNEL_ID=$EXISTING_SFTP_TUNNEL_ID
SFTP_TUNNEL_HOST=$EXISTING_SFTP_TUNNEL_HOST
SFTP_TUNNEL_PORT=$EXISTING_SFTP_TUNNEL_PORT
ENVFILE
        echo "Agent Service .env written."

        # Phase 2: Deferred — install all prerequisites after dpkg releases its lock,
        # then launch the tray. The tray's first-run dialog handles key entry and
        # calls setup.sh --reconfigure which registers the desktop with Orchestra.
        mkdir -p "$LOG_DIR"
        (
            # Wait for dpkg to release its lock
            while fuser /var/lib/dpkg/lock-frontend &>/dev/null 2>&1; do
                sleep 2
            done

            echo "[$(date)] dpkg lock released, running deferred setup..."

            TARGET_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"

            # Clear dpkg maintainer-script vars so setup.sh can call apt freely.
            unset DPKG_MAINTSCRIPT_PACKAGE DPKG_MAINTSCRIPT_NAME DPKG_MAINTSCRIPT_ARCH

            # Install all prerequisites (Node.js, bun, websockify, noVNC, magnitude,
            # agent-service deps, rathole) and configure systemd/autostart units.
            # No key required at this stage.
            echo "[$(date)] Running setup.sh --prereqs-only..."
            SUDO_USER="${SUDO_USER:-$TARGET_USER}" \
            "$SETUP_SCRIPT" --prereqs-only || {
                echo "[$(date)] WARNING: setup.sh --prereqs-only encountered errors" >&2
            }

            # Detect DISPLAY for tray launch
            DISPLAY_ENV="$APP_DIR/logs/display.env"
            if [ -f "$DISPLAY_ENV" ]; then
                . "$DISPLAY_ENV"
            fi
            DISPLAY="${DISPLAY:-:0}"
            export DISPLAY

            # Launch tray app — it will show the first-run dialog to collect the key.
            if [ -f "$APP_DIR/gui/unify-assistant.py" ]; then
                echo "[$(date)] Launching tray app (DISPLAY=$DISPLAY)..."
                su - "$TARGET_USER" -c "DISPLAY=$DISPLAY nohup python3 $APP_DIR/gui/unify-assistant.py &>/dev/null &" || true
            fi

            echo "[$(date)] Post-install complete."
        ) &>"$LOG_DIR/postinst-deferred.log" &
        disown

        echo ""
        echo "=================================================="
        echo "  Unify Desktop Assistant is installed"
        echo "=================================================="
        echo ""
        echo "Dependencies and services are being set up in the background"
        echo "(this can take a few minutes on first install)."
        echo ""
        echo "The Unify icon will appear in your system tray and turn green"
        echo "once services are running. You can change your API key anytime"
        echo "from the tray icon's Settings."
        echo ""
        echo "Progress: tail -f $LOG_DIR/postinst-deferred.log"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
