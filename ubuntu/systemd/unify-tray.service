[Unit]
Description=Unify Desktop Assistant - System Tray GUI
Documentation=https://unify.ai
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %INSTALL_DIR%/gui/unify-assistant.py
Environment=DISPLAY=%DISPLAY%
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
