    "prettier": "^3.5.3",
    "sharp": "0.35.3",
    "turbo": "^2.4.4",
    "typescript": "5.8.2",
    "undici": "7.29.0",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=18"
  },
